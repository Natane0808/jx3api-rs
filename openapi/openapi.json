{"openapi":"3.0.3","info":{"title":"JX3API 接口文档","version":"1.0.0","description":"剑网3 数据接口，支持角色、装备、榜单、交易等多维度数据。"},"servers":[{"url":"https://www.jx3api.com"}],"x-render":"http","x-token":{"show":true,"type":1,"levels":2,"tabs":["manage","stats","buy","reset","redeem","recover"],"buy":{"customMin":1000,"plans":[{"count":5000,"price":50},{"count":10000,"price":100},{"count":30000,"price":300}]}},"x-sdks":{"title":"SDK","subtitle":"多语言封装，开箱即用 · 来自 <a href=\"https://qm.qq.com/q/kcBhnCXsuA\" target=\"_blank\" rel=\"noopener\">JX3API</a> 女生自用版","list":[{"lang":"Python","abbr":"PY","color":"#3776ab","name":"JX3API-PY","url":"https://github.com/JX3API/jx3api-py"},{"lang":"Python","abbr":"PY","color":"#3776ab","name":"JX3API-FUN-PY","url":"https://github.com/JX3API/jx3api-fun-py"},{"lang":"TypeScript","abbr":"TS","color":"#3178c6","name":"JX3API-TS","url":"https://github.com/JX3API/JX3API-TS"},{"lang":"Java","abbr":"JAVA","color":"#e76f00","name":"JX3API-JAVA","url":"https://github.com/JX3API/JX3API-JAVA"},{"lang":"Go","abbr":"Go","color":"#00add8","name":"JX3API-GO","url":"https://github.com/JX3API/jx3api-go"},{"lang":"C#","abbr":"C#","color":"#512bd4","name":"JX3API-.NET","url":"https://github.com/JX3API/JX3API-.NET"}]},"x-ui":{"home":{"title":"JX3API","lead":"剑网3 数据接口 · 角色、装备、榜单、交易等多维度数据，左侧选择接口即可在线调试。","stats":true,"statLabels":["接口总数","功能模块","功能分类"]}},"x-announcement":{"enabled":false,"version":2026072601,"title":"文档公告","body":"<p><b style=\"color:#7c3aed\">🎉 本次重大更新</b></p><p><b>1. 令牌体系升级</b>：原有令牌全部停用。请前往首页「令牌 → 换新」，用<b>旧令牌 + 邮箱</b>换取新格式令牌。</p><p><b>2. 数据源迁移</b>：所有数据从 MySQL 迁移至 <b>MongoDB</b>，读写更快、并发更稳。</p><p><b>3. 文档 UI 重构</b>：内置在线调试面板，接口点开即可直接发送请求。</p><p><b>4. 接口能力扩大</b>：开放一批原自用接口，欢迎发掘。</p>"},"x-changelog":{"entries":[{"date":"2026-11-04","title":"装备数据上报与属性系数更新","summary":"修复未生效精炼与五行石上报，装备属性系数适配正式服客户端 1.6.0.10053。","items":[{"type":"fixed","title":"按装备实际生效情况上报","body":"修复部分装备仍上报上赛季未生效精炼等级和五行石数据的问题。现在按当前装备实际生效情况上报，避免影响装备评分与角色属性计算。","paths":["/calcd/attribute","/calcd/detail"]},{"type":"changed","title":"装备属性系数适配客户端 1.6.0.10053","body":"根据官方客户端 1.6.0.10053 的属性调整：力道、元气转基础攻击系数均由 0.195 调整为 0.190，转基础破防系数均由 0.061 调整为 0.060。装备属性计算已同步适配。","paths":["/calcd/attribute","/calcd/detail"]}]},{"date":"2026-10-15","title":"角色配装、赤兔查询与充值调整","summary":"新增角色配装查询，升级赤兔预告与出世记录，充值与续费 10 元起。","items":[{"type":"changed","title":"今日赤兔与本周赤兔升级","body":"今日赤兔与本周赤兔支持查询预告、出世及预测状态，并展示时间信息。本周记录按周二 07:00 重置的周期查询。","paths":["/chitu/records","/chitu/week/records"]},{"type":"added","title":"角色属性与配装查询","body":"新增角色属性、配装记录和配装详情接口。属性与详情支持 calcd（计算后的数据）和 client（客户端原始数据）两种格式，默认 calcd。","paths":["/calcd/attribute","/calcd/records","/calcd/detail"]},{"type":"changed","title":"配装接口命名统一","body":"配装记录使用 records，配装详情使用 detail；通过角色、心法和装备类型查询指定配装。"},{"type":"changed","title":"自定义充值与续费 10 元起","body":"自定义购买最低 1000 次，对应 10 元。新购和续费适用同一标准，页面与下单接口同步校验。"}]}]},"tags":[{"name":"活动日历"},{"name":"名剑相关"},{"name":"阵营竞拍"},{"name":"帮战记录"},{"name":"角色属性"},{"name":"角色名片"},{"name":"世界首领"},{"name":"聊天记录"},{"name":"赤兔查询"},{"name":"多玩语音"},{"name":"奇遇相关"},{"name":"科举搜索"},{"name":"烟花事件"},{"name":"小吃小药"},{"name":"骗子查询"},{"name":"家园相关"},{"name":"秘境方位"},{"name":"师徒相关"},{"name":"百战记录"},{"name":"新闻公告"},{"name":"马场查询"},{"name":"排行榜单"},{"name":"团队招募"},{"name":"掉落统计"},{"name":"角色信息"},{"name":"阵营沙盘"},{"name":"骚话语录"},{"name":"心法配装"},{"name":"大区状态"},{"name":"急速计算"},{"name":"语音合成"},{"name":"的卢拍卖"},{"name":"百度贴吧"},{"name":"物价交易"},{"name":"试炼之地"},{"name":"资历分布"},{"name":"诛恶事件"}],"x-tagGroups":[{"name":"活动情报","tags":["活动日历","世界首领","赤兔查询","烟花事件","马场查询"]},{"name":"排行榜单","tags":["名剑相关","排行榜单","资历分布"]},{"name":"物价交易","tags":["阵营竞拍","的卢拍卖","物价交易"]},{"name":"阵营战场","tags":["帮战记录","阵营沙盘","诛恶事件"]},{"name":"角色查询","tags":["角色属性","角色名片","奇遇相关","百战记录","角色信息","心法配装"]},{"name":"游戏社区","tags":["聊天记录","多玩语音","小吃小药","骗子查询","家园相关","师徒相关","新闻公告","团队招募","骚话语录","百度贴吧"]},{"name":"系统工具","tags":["科举搜索","大区状态","急速计算","语音合成"]},{"name":"副本秘境","tags":["秘境方位","掉落统计"]},{"name":"试炼之地","tags":["试炼之地"]}],"paths":{"/active/calendar":{"get":{"tags":["活动日历"